{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarlock.dev/contracts/runtime_manifest_v2.schema.json",
  "title": "InvarLock Runtime Manifest v2",
  "type": "object",
  "required": [
    "manifest_version",
    "generated_at_utc",
    "verifier_contract_version",
    "report",
    "config",
    "execution_mode",
    "outer_container",
    "runtime_provider"
  ],
  "properties": {
    "manifest_version": {"const": 2},
    "generated_at_utc": {
      "type": "string",
      "format": "date-time",
      "minLength": 20
    },
    "verifier_contract_version": {"const": "runtime-manifest-v2"},
    "report": {"$ref": "#/$defs/reportReference"},
    "config": {"$ref": "#/$defs/configReference"},
    "execution_mode": {"const": "container"},
    "outer_container": {"$ref": "#/$defs/outerContainer"},
    "runtime_provider": {"$ref": "#/$defs/runtimeProviderBindings"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "basename": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\\\u0000-\\u001f]+$",
      "not": {"enum": [".", ".."]}
    },
    "portableImageReference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\\\u0000-\\u001f]+$"
    },
    "reportReference": {
      "type": "object",
      "required": ["path", "filename", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/basename"},
        "filename": {"$ref": "#/$defs/basename"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "configReference": {
      "type": "object",
      "required": ["path", "sha256", "source"],
      "properties": {
        "path": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/basename"}]
        },
        "sha256": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "source": {"enum": ["file", "inline", "missing"]}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "missing"}}},
          "then": {
            "properties": {
              "path": {"const": null},
              "sha256": {"const": null}
            }
          },
          "else": {"properties": {"sha256": {"$ref": "#/$defs/sha256"}}}
        },
        {
          "if": {"properties": {"source": {"const": "file"}}},
          "then": {"properties": {"path": {"$ref": "#/$defs/basename"}}}
        },
        {
          "if": {"properties": {"source": {"const": "inline"}}},
          "then": {"properties": {"path": {"const": null}}}
        }
      ],
      "additionalProperties": false
    },
    "outerContainer": {
      "type": "object",
      "required": [
        "image_ref",
        "image_digest",
        "container_execution",
        "allow_network",
        "allow_remote_code",
        "allow_third_party_plugins"
      ],
      "properties": {
        "image_ref": {"$ref": "#/$defs/portableImageReference"},
        "image_digest": {"$ref": "#/$defs/imageDigest"},
        "container_execution": {"const": true},
        "allow_network": {"type": "boolean"},
        "allow_remote_code": {"type": "boolean"},
        "allow_third_party_plugins": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "sidecarReference": {
      "type": "object",
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {"$ref": "#/$defs/basename"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "runtimeProviderBindings": {
      "type": "object",
      "required": ["receipt", "scoring_observation", "artifact_identity"],
      "properties": {
        "receipt": {"$ref": "#/$defs/sidecarReference"},
        "scoring_observation": {"$ref": "#/$defs/sidecarReference"},
        "artifact_identity": {"$ref": "#/$defs/sidecarReference"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
