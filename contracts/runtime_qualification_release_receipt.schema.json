{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarlock.dev/contracts/runtime_qualification_release_receipt.schema.json",
  "title": "InvarLock Runtime Qualification Release Receipt",
  "type": "object",
  "required": [
    "format_version",
    "claim_scope",
    "provider_name",
    "platform_profile",
    "source_commit",
    "source_archive_sha256",
    "runtime_image_digest",
    "qualification_format",
    "qualification_summary_sha256",
    "qualification_evidence_sha256",
    "qualified_device_count"
  ],
  "properties": {
    "format_version": {
      "const": "invarlock/runtime-qualification-release-receipt-v1"
    },
    "claim_scope": {
      "const": "runtime_qualification_only"
    },
    "provider_name": {
      "enum": ["llama_cpp", "tensorrt_llm"]
    },
    "qualification_name": {
      "$ref": "#/$defs/qualificationName"
    },
    "platform_profile": {
      "enum": [
        "linux_cpu",
        "linux_nvidia_gpu_compute_capability_9_0"
      ]
    },
    "source_commit": {
      "$ref": "#/$defs/gitCommit"
    },
    "source_archive_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_image_digest": {
      "$ref": "#/$defs/imageDigest"
    },
    "qualification_format": {
      "enum": [
        "invarlock/gguf-runtime-blackbox-summary-v1",
        "invarlock/tensorrt-llm-dual-gpu-qualification-v1"
      ]
    },
    "qualification_summary_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "qualification_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "qualified_device_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider_name": {"const": "llama_cpp"}
        },
        "required": ["provider_name"]
      },
      "then": {
        "properties": {
          "platform_profile": {"const": "linux_cpu"},
          "qualification_format": {
            "const": "invarlock/gguf-runtime-blackbox-summary-v1"
          },
          "qualified_device_count": {"const": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider_name": {"const": "tensorrt_llm"}
        },
        "required": ["provider_name"]
      },
      "then": {
        "properties": {
          "platform_profile": {
            "const": "linux_nvidia_gpu_compute_capability_9_0"
          },
          "qualification_format": {
            "const": "invarlock/tensorrt-llm-dual-gpu-qualification-v1"
          },
          "qualified_device_count": {"const": 2}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "qualificationName": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
    }
  },
  "additionalProperties": false
}
