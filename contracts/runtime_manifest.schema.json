{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvarLock Runtime Manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "generated_at_utc",
    "verifier_contract_version",
    "report",
    "config",
    "execution_mode",
    "runtime"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time",
      "minLength": 20
    },
    "verifier_contract_version": {
      "const": "runtime-manifest-v1"
    },
    "report": {
      "type": "object",
      "required": [
        "path",
        "filename",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "source"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "source": {
          "enum": [
            "file",
            "inline",
            "missing"
          ]
        }
      },
      "additionalProperties": false
    },
    "execution_mode": {
      "enum": [
        "container",
        "host-bypass"
      ]
    },
    "runtime": {
      "type": "object",
      "required": [
        "image_ref",
        "image_digest",
        "container_execution",
        "allow_network",
        "allow_remote_code",
        "allow_third_party_plugins"
      ],
      "properties": {
        "image_ref": {
          "type": "string",
          "minLength": 1
        },
        "image_digest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          ]
        },
        "container_execution": {
          "type": "boolean"
        },
        "allow_network": {
          "type": "boolean"
        },
        "allow_remote_code": {
          "type": "boolean"
        },
        "allow_third_party_plugins": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
