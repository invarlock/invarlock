{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvarLock Verify JSON Output",
  "type": "object",
  "required": [
    "format_version",
    "summary",
    "results"
  ],
  "properties": {
    "format_version": {
      "const": "verify-v1"
    },
    "summary": {
      "type": "object",
      "required": [
        "ok",
        "reason"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "ok",
            "policy_fail",
            "malformed"
          ]
        }
      },
      "additionalProperties": true
    },
    "evaluation_report": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "schema_version",
          "kind",
          "ok",
          "reason",
          "ci"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "schema_version": {
            "const": "v1"
          },
          "kind": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "reason": {
            "enum": [
              "ok",
              "policy_fail",
              "malformed"
            ]
          },
          "ratio_vs_baseline": {
            "type": "number"
          },
          "delta_vs_baseline_pp": {
            "type": "number"
          },
          "ci": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            ]
          },
          "recompute": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "family",
                  "performed",
                  "ok",
                  "reason"
                ],
                "properties": {
                  "family": {
                    "enum": [
                      "accuracy",
                      "ppl"
                    ]
                  },
                  "performed": {
                    "type": "boolean"
                  },
                  "ok": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "performed": {
                          "const": false
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "ok": {
                          "type": "null"
                        },
                        "reason": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "performed": {
                          "const": true
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "ok": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "performed": {
                          "const": true
                        },
                        "ok": {
                          "const": true
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "reason": {
                          "type": "null"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "performed": {
                          "const": true
                        },
                        "ok": {
                          "const": false
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "reason": {
                          "const": "mismatch"
                        }
                      }
                    }
                  }
                ],
                "additionalProperties": false
              }
            ]
          },
          "guard_warnings_present": {
            "type": "boolean"
          },
          "warning_count": {
            "type": "integer",
            "minimum": 0
          },
          "verification": {
            "type": "object"
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "accuracy"
                }
              }
            },
            "then": {
              "required": [
                "delta_vs_baseline_pp"
              ],
              "not": {
                "required": [
                  "ratio_vs_baseline"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "ppl_causal",
                    "ppl_mlm",
                    "ppl_seq2seq"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "ratio_vs_baseline"
              ],
              "not": {
                "required": [
                  "delta_vs_baseline_pp"
                ]
              }
            }
          }
        ]
      }
    },
    "error": {
      "type": "object"
    },
    "resolution": {
      "type": "object",
      "properties": {
        "exit_code": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
