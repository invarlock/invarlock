{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvarLock Proof Pack Manifest",
  "type": "object",
  "required": [
    "format",
    "checksums_sha256",
    "checksums_sha256_digest"
  ],
  "properties": {
    "format": {
      "const": "proof-pack-v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "network_mode": {
      "enum": [
        "offline",
        "online"
      ]
    },
    "determinism": {
      "type": "string",
      "minLength": 1
    },
    "repeats": {
      "type": "integer",
      "minimum": 0
    },
    "determinism_repeats": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "run_dir": {
      "type": "string",
      "minLength": 1
    },
    "invarlock_version": {
      "type": "string"
    },
    "model_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "revision"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checksums_sha256": {
      "const": "checksums.sha256"
    },
    "checksums_sha256_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "model_licenses": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object"
    },
    "signing_key_fingerprint": {
      "type": "string",
      "minLength": 16
    }
  },
  "additionalProperties": true
}
