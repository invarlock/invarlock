{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarlock.dev/contracts/runtime_release_evidence_index.schema.json",
  "title": "InvarLock Runtime Release Evidence Index",
  "type": "object",
  "required": [
    "format_version",
    "source_commit",
    "source_archive_sha256",
    "qualifications",
    "behavioral_claims"
  ],
  "properties": {
    "format_version": {
      "const": "invarlock/runtime-release-evidence-index-v1"
    },
    "source_commit": {
      "$ref": "#/$defs/gitCommit"
    },
    "source_archive_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "qualifications": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "provider_name",
          "claim_scope",
          "receipt_path",
          "receipt_sha256",
          "summary_path",
          "summary_sha256"
        ],
        "properties": {
          "provider_name": {
            "enum": ["llama_cpp", "tensorrt_llm"]
          },
          "qualification_name": {
            "$ref": "#/$defs/qualificationName"
          },
          "claim_scope": {
            "const": "runtime_qualification_only"
          },
          "receipt_path": {
            "type": "string",
            "pattern": "^receipts/(?:llama_cpp|tensorrt_llm)(?:-[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?)?-qualification\\.json$"
          },
          "receipt_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "summary_path": {
            "type": "string",
            "pattern": "^summaries/(?:llama_cpp|tensorrt_llm)(?:-[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?)?-qualification-summary\\.json$"
          },
          "summary_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    },
    "behavioral_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_scope",
          "receipt_path",
          "receipt_sha256"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^claim-[a-f0-9]{64}$"
          },
          "claim_scope": {
            "const": "schedule_level_behavior"
          },
          "receipt_path": {
            "type": "string",
            "pattern": "^receipts/claim-[a-f0-9]{64}-behavior\\.json$"
          },
          "receipt_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "anyOf": [
    {"properties": {"qualifications": {"minItems": 1}}},
    {"properties": {"behavioral_claims": {"minItems": 1}}}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "qualificationName": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
    }
  },
  "additionalProperties": false
}
