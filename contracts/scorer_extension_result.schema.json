{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarlock.dev/contracts/scorer_extension_result.schema.json",
  "title": "InvarLock verifier-replayed scorer result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "scorer_abi",
    "scorer_id",
    "scorer_version",
    "descriptor_sha256",
    "configuration_sha256",
    "schedule_sha256",
    "source_records_sha256",
    "record_results",
    "aggregate",
    "aggregate_source_sha256"
  ],
  "properties": {
    "format_version": {"const": "invarlock/scorer-extension-result-v1"},
    "scorer_abi": {"const": "1"},
    "scorer_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}(\\.[a-z][a-z0-9_]{0,63})+$"
    },
    "scorer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "descriptor_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schedule_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_records_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "input_sha256", "value"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "value": {"type": "number", "minimum": 0.0, "maximum": 1.0}
        }
      }
    },
    "aggregate": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "aggregate_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
