{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvarLock Policy Pack",
  "type": "object",
  "required": [
    "format",
    "tier",
    "resolved_policy",
    "overrides",
    "policy_digest",
    "compatibility"
  ],
  "properties": {
    "format": {
      "const": "policy-pack-v1"
    },
    "tier": {
      "type": "string",
      "minLength": 1
    },
    "resolved_policy": {
      "type": "object"
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policy_digest": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16
    },
    "compatibility": {
      "type": "object",
      "required": [
        "support_tiers"
      ],
      "properties": {
        "support_tiers": {
          "type": "array",
          "items": {
            "enum": [
              "published_basis",
              "supported_experimental",
              "community_experimental"
            ]
          }
        },
        "adapter_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_lanes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "approval": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string"
        },
        "change_ticket": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "effective_date": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
