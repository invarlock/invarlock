+            }
+        }
+    }
+    impl Default for Storage<String, Value> {
+        fn default() -> Self {
+            Self::new()
+        }
+    }
+    impl Deref for Storage<String, Value> {
+        type Target = IndexMap<String, Value>;
+        fn deref(&self) -> &Self::Target {
+            static EMPTY: OnceLock<IndexMap<String, Value>> = OnceLock::new();
+            self.0
+                .as_deref()
+                .unwrap_or_else(|| EMPTY.get_or_init(IndexMap::new))
+        }
+    }
+    impl DerefMut for Storage<String, Value> {
+        fn deref_mut(&mut self) -> &mut Self::Target {
+            self.0.get_or_insert_with(|| Box::new(IndexMap::new()))
+        }
+    }
+    impl FromIterator<(String, Value)> for Storage<String, Value> {
+        fn from_iter<T: IntoIterator<Item = (String, Value)>>(iter: T) -> Self {
+            let mut map = Self::new();
+            map.extend(iter);
+            map
+        }
+    }
+    impl Extend<(String, Value)> for Storage<String, Value> {
+        fn extend<T: IntoIterator<Item = (String, Value)>>(&mut self, iter: T) {
+            let mut iter = iter.into_iter();
+            if let Some(first) = iter.next() {
+                self.deref_mut().extend(core::iter::once(first).chain(iter));
+            }
+        }
+    }
+    impl IntoIterator for Storage<String, Value> {
+        type Item = (String, Value);
+        type IntoIter = indexmap::map::IntoIter<String, Value>;
+        fn into_iter(self) -> Self::IntoIter {
+            self.into_inner().into_iter()
+        }
+    }
+}
 
