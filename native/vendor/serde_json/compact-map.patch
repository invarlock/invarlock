+// Preserve IndexMap's ordering and APIs while keeping its large header out of
+// every Value slot. Empty maps do not need a boxed header until first insertion.
+#[cfg(feature = "preserve_order")]
+mod compact {
+    use super::*;
+    use alloc::boxed::Box;
+    use core::ops::{Deref, DerefMut};
+    use std::sync::OnceLock;
+
+    #[derive(Clone)]
+    pub(super) struct Storage<K, V>(Option<Box<IndexMap<K, V>>>);
+    impl Storage<String, Value> {
+        pub(super) fn new() -> Self {
+            Self(None)
+        }
+        pub(super) fn with_capacity(capacity: usize) -> Self {
+            if capacity == 0 {
+                Self::new()
+            } else {
+                Self(Some(Box::new(IndexMap::with_capacity(capacity))))
+            }
+        }
+        fn into_inner(self) -> IndexMap<String, Value> {
+            self.0.map(|map| *map).unwrap_or_default()
+        }
+        pub(super) fn into_values(self) -> indexmap::map::IntoValues<String, Value> {
+            self.into_inner().into_values()
+        }
+        pub(super) fn get_mut<Q>(&mut self, key: &Q) -> Option<&mut Value>
+        where
+            String: Borrow<Q>,
+            Q: ?Sized + Eq + Hash,
+        {
+            self.0.as_deref_mut()?.get_mut(key)
+        }
+        pub(super) fn swap_remove<Q>(&mut self, key: &Q) -> Option<Value>
+        where
+            String: Borrow<Q>,
+            Q: ?Sized + Eq + Hash,
+        {
+            self.0.as_deref_mut()?.swap_remove(key)
+        }
+        pub(super) fn swap_remove_entry<Q>(&mut self, key: &Q) -> Option<(String, Value)>
+        where
+            String: Borrow<Q>,
+            Q: ?Sized + Eq + Hash,
+        {
+            self.0.as_deref_mut()?.swap_remove_entry(key)
+        }
+        pub(super) fn shift_remove<Q>(&mut self, key: &Q) -> Option<Value>
+        where
+            String: Borrow<Q>,
+            Q: ?Sized + Eq + Hash,
+        {
+            self.0.as_deref_mut()?.shift_remove(key)
+        }
+        pub(super) fn shift_remove_entry<Q>(&mut self, key: &Q) -> Option<(String, Value)>
+        where
+            String: Borrow<Q>,
+            Q: ?Sized + Eq + Hash,
+        {
+            self.0.as_deref_mut()?.shift_remove_entry(key)
+        }
+        pub(super) fn clear(&mut self) {
+            if let Some(map) = &mut self.0 {
+                map.clear();
+            }
+        }
+        pub(super) fn iter_mut(&mut self) -> indexmap::map::IterMut<'_, String, Value> {
+            self.0
+                .as_deref_mut()
+                .map(IndexMap::iter_mut)
+                .unwrap_or_default()
+        }
+        pub(super) fn values_mut(&mut self) -> indexmap::map::ValuesMut<'_, String, Value> {
+            self.0
+                .as_deref_mut()
+                .map(IndexMap::values_mut)
+                .unwrap_or_default()
+        }
+        pub(super) fn retain<F: FnMut(&String, &mut Value) -> bool>(&mut self, f: F) {
+            if let Some(map) = &mut self.0 {
+                map.retain(f);
+            }
+        }
