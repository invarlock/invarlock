exclude sitecustomize.py
global-exclude .DS_Store ._* Thumbs.db desktop.ini

# Exclude development assets from sdist/wheels
recursive-exclude tests *
recursive-exclude tools *
recursive-exclude docs *

# Keep repo scripts/presets out of artifact (matrix/presets are repo-first)
prune scripts
prune configs

# Ensure license and third-party notices are included in source distributions
include LICENSE
include THIRD_PARTY_NOTICES.md
