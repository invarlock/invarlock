{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarlock.dev/schemas/verifier_carrying_artifact.v1.schema.json",
  "title": "Verifier-Carrying Artifact (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "guard_evidence", "verifier_traces", "provenance"],
  "properties": {
    "schema_version": { "const": "verifier_carrying_artifact.v1" },
    "guard_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invarlock"],
      "properties": {
        "invarlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluation_report"],
          "properties": {
            "evaluation_report": {
              "$ref": "#/$defs/file_ref"
            },
            "verify": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "profile": {
                  "type": "string",
                  "enum": ["dev", "ci", "release"]
                },
                "ok": { "type": "boolean" },
                "errors": { "type": "array", "items": { "type": "string" } },
                "verify_json": {
                  "description": "Optional embedded output of `invarlock verify --json`.",
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "verifier_traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://invarlock.dev/schemas/verifier_trace.v1.schema.json"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "tooling"],
      "properties": {
        "created_at": { "type": "string" },
        "tooling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "invarlock_version": { "type": "string" },
            "schema_verify_version": { "type": "string" },
            "git_commit": { "type": "string" }
          }
        },
        "notes": { "type": "string" },
        "extensions": { "type": "object" }
      }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "embedded": {
          "description": "Optional embedded copy of the referenced JSON (useful for small artifacts).",
          "type": "object"
        }
      }
    }
  }
}

