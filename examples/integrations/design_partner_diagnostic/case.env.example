# Copy this file to case.env, keep that copy out of source control, and replace
# every REPLACE_WITH_* value before running the diagnostic.

# Reviewer-owned case identity and immutable model selection.
CASE_ID="REPLACE_WITH_CASE_ID"
BASELINE_MODEL="REPLACE_WITH_REVIEWED_BASELINE_MODEL_OR_PATH"
BASELINE_REVISION="REPLACE_WITH_IMMUTABLE_BASELINE_REVISION"
BASELINE_ADAPTER="auto"

# The subject must be the output of a real transformation, not the baseline
# under another name. Keep the transformation receipt with the case record.
# Set SUBJECT_REVISION to an immutable 40-64 character commit for a remote
# subject, or to an empty string for a local checkpoint path.
SUBJECT_MODEL="REPLACE_WITH_TRANSFORMED_SUBJECT_MODEL_OR_PATH"
SUBJECT_REVISION="REPLACE_WITH_IMMUTABLE_SUBJECT_REVISION_OR_EMPTY_FOR_LOCAL"
SUBJECT_ADAPTER="auto"
SUBJECT_CHANGE_KIND="REPLACE_WITH_QUANTIZATION_PRUNING_ADAPTER_OR_FINE_TUNING"
SUBJECT_TRANSFORMATION_RECEIPT="REPLACE_WITH_TRANSFORMATION_RECEIPT_PATH"

# Obtain these three trust inputs from reviewer-controlled channels independent
# of the submitted subject and generated report bundle.
BASELINE_REPORT="REPLACE_WITH_RETAINED_RAW_BASELINE_REPORT"
POLICY_PACK="REPLACE_WITH_ACCEPTANCE_POLICY_PACK"
EXPECTED_RUNTIME_IMAGE_DIGEST="sha256:REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS"

# This runbook uses the shipped balanced policy in its all-enforce acceptance
# mode. An observe override is a separate diagnostic policy decision.
PROFILE="ci"
TIER="balanced"
EXPECTED_GUARD_AUTHORITY="enforce"

# Generated files are local review artifacts and remain outside source control.
REPORT_OUT="reports/design-partner/REPLACE_WITH_CASE_ID"
ALLOW_NETWORK="0"
