        "runtime_provenance_status": "expected_image_digest_matched",
        "runtime_expected_digest_matched": true
      },
      "required_artifacts": [
        "evaluation.report.json",
        "verify.json",
        "runtime.manifest.json",
        "evaluation.html",
        "backend_inventory.json",
