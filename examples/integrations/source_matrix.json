{
  "schema": "invarlock.integration_source_matrix.v1",
  "description": "Machine-readable artifact and replay contract for documented strict integration lanes. Generated run artifacts stay outside source control; each entry distinguishes the producer-declared runtime digest from the independent verifier trust-anchor source and records the verifier profile, required sidecars, and acceptance conditions for a newly generated run.",
