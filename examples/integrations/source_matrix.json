{
  "schema": "invarlock.integration_source_matrix.v1",
  "description": "Machine-readable contract for integration READMEs that claim verified strict container evidence. Generated run artifacts stay outside source control; each entry records the target, strict lane, runtime image source, expected verifier/provenance status, and sidecars that a current run must produce.",
  "entries": [
    {
      "target": "awq",
      "readme": "examples/integrations/awq/README.md",
      "runner": "examples/integrations/awq/run_tiny_awq.sh",
      "status_label": "runnable",
      "strict_claim_phrase": "strict container evidence is verified",
      "subject_form": "materialized-checkpoint",
      "subject_adapter": "hf_awq",
      "lane": "cuda-container-strict",
      "command_shape": "--lane cuda",
      "report_path": "reports/tiny-awq/<artifact-lane>",
      "runtime_image": {
        "family": "cuda-gptqmodel",
        "source_command": "examples/integrations/_runtime_images/build_example_runtime_image.sh cuda-gptqmodel",
        "digest_source": "runtime.manifest.json"
      },
      "expected": {
        "lane_artifact_label": "cuda-container-strict",
        "verify_status": "ok",
        "runtime_provenance_declared": "container",
        "runtime_provenance_verified": true
      },
      "required_artifacts": [
        "evaluation.report.json",
        "verify.json",
        "runtime.manifest.json",
        "evaluation.html",
        "backend_inventory.json",
        "lane_artifact.json",
        "run_command.txt",
        "run_summary.txt"
      ],
      "runner_enforcement": {
        "backend_inventory": "--require-backend-inventory"
      }
    },
