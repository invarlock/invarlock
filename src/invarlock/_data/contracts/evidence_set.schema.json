{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarlock.dev/contracts/evidence_set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "invarlock/evidence-set-v1"
    },
    "members": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deterministic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "captured"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?!/)(?!~)(?![A-Za-z]:)(?!.*://)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!\\s)(?!.*\\s$)(?!.*\\/$)[^\\u0000-\\u001f]+$"
            },
            "statement_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "minLength": 71,
              "maxLength": 71
            }
          },
          "required": [
            "kind",
            "path",
            "statement_sha256"
          ]
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "judge"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?!/)(?!~)(?![A-Za-z]:)(?!.*://)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!\\s)(?!.*\\s$)(?!.*\\/$)[^\\u0000-\\u001f]+$"
            },
            "statement_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "minLength": 71,
              "maxLength": 71
            }
          },
          "required": [
            "kind",
            "path",
            "statement_sha256"
          ]
        }
      },
      "required": [
        "deterministic",
        "judge"
      ]
    }
  },
  "required": [
    "format",
    "members"
  ]
}
