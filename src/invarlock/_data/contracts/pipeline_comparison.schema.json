{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarlock.dev/contracts/pipeline_comparison.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "invarlock/pipeline-comparison-v1"
    },
    "decision": {
      "enum": [
        "pass",
        "regression",
        "insufficient_evidence"
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "candidate": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "policy": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "baseline",
        "candidate",
        "policy"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "slice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "direction": {
            "enum": [
              "higher",
              "lower"
            ]
          },
          "aggregation": {
            "const": "mean"
          },
          "scoring_assurance": {
            "enum": [
              "recomputed",
              "recorded"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "missing_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            }
          },
          "baseline_mean": {
            "type": [
              "number",
              "null"
            ]
          },
          "candidate_mean": {
            "type": [
              "number",
              "null"
            ]
          },
          "delta": {
            "type": [
              "number",
              "null"
            ]
          },
          "interval": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "lower": {
                    "type": "number"
                  },
                  "upper": {
                    "type": "number"
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                  },
                  "mass": {
                    "type": "number"
                  },
                  "replicates": {
                    "type": "integer"
                  }
                },
                "required": [
                  "lower",
                  "upper",
                  "method",
                  "mass",
                  "replicates"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "decision": {
            "enum": [
              "pass",
              "regression",
              "insufficient_evidence"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        "required": [
          "name",
          "slice",
          "kind",
          "unit",
          "direction",
          "aggregation",
          "scoring_assurance",
          "count",
          "missing_ids",
          "baseline_mean",
          "candidate_mean",
          "delta",
          "interval",
          "decision",
          "reasons"
        ]
      },
      "maxItems": 272
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    }
  },
  "required": [
    "format",
    "decision",
    "bindings",
    "metrics",
    "limitations"
  ]
}
