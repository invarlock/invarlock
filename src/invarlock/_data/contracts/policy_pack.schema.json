{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvarLock Policy Pack",
  "type": "object",
  "required": [
    "format",
    "tier",
    "resolved_policy",
    "overrides",
    "policy_digest",
    "compatibility"
  ],
  "properties": {
    "format": {
      "enum": ["policy-pack-v1", "policy-pack-v2", "policy-pack-v3"]
    },
    "tier": {
      "enum": ["aggressive", "balanced", "conservative"]
    },
    "resolved_policy": {
      "type": "object"
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "value"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
          },
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "compatibility": {
      "type": "object",
      "required": ["support_tiers"],
      "properties": {
        "support_tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "adapter_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "runtime_lanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "dataset_identity": {
          "type": "object",
          "required": [
            "provider",
            "dataset_name",
            "config_name",
            "revision",
            "split"
          ],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "dataset_name": {"type": ["string", "null"]},
            "config_name": {"type": ["string", "null"]},
            "revision": {"type": ["string", "null"]},
            "split": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "change_ticket": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "effective_date": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    },
    "behavioral_claim": {
      "type": "object",
      "required": [
        "claim_set",
        "allowed_provider_names",
        "allowed_artifact_formats",
        "required_capabilities",
        "metric_policy"
      ],
      "properties": {
        "claim_set": {
          "const": "invarlock-runtime-behavioral-regression-v1"
        },
        "allowed_provider_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "allowed_artifact_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["hf_snapshot", "gguf", "tensorrt_llm_engine"]
          }
        },
        "required_capabilities": {
          "type": "object",
          "required": ["tasks", "metrics", "evidence_surfaces"],
          "properties": {
            "tasks": {
              "const": ["text_causal"]
            },
            "metrics": {
              "const": ["exact_match"]
            },
            "evidence_surfaces": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": ["behavior", "tokenizer", "build"]
              },
              "allOf": [
                {"contains": {"const": "behavior"}},
                {"contains": {"const": "tokenizer"}}
              ]
            }
          },
          "additionalProperties": false
        },
        "metric_policy": {
          "type": "object",
          "required": ["kind", "minimum_subject_score", "maximum_regression"],
          "properties": {
            "kind": {
              "const": "exact_match"
            },
            "minimum_subject_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maximum_regression": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"format": {"const": "policy-pack-v1"}},
        "required": ["format"]
      },
      "then": {
        "properties": {
          "resolved_policy": {
            "not": {"required": ["guard_authority"]}
          },
          "compatibility": {
            "properties": {
              "support_tiers": {
                "items": {
                  "enum": [
                    "published_basis",
                    "supported_experimental",
                    "community_experimental"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"format": {"const": "policy-pack-v2"}},
        "required": ["format"]
      },
      "then": {
        "properties": {
          "resolved_policy": {
            "required": ["guard_authority"],
            "properties": {
              "guard_authority": {
                "type": "object",
                "required": ["spectral", "rmt", "variance"],
                "properties": {
                  "spectral": {"enum": ["observe", "enforce"]},
                  "rmt": {"enum": ["observe", "enforce"]},
                  "variance": {"enum": ["observe", "enforce"]}
                },
                "additionalProperties": false
              }
            }
          },
          "compatibility": {
            "properties": {
              "support_tiers": {
                "items": {
                  "enum": [
                    "maintained_catalog",
                    "supported_experimental",
                    "community_experimental"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"format": {"const": "policy-pack-v3"}},
        "required": ["format"]
      },
      "then": {
        "required": ["behavioral_claim"],
        "properties": {
          "resolved_policy": {
            "not": {"required": ["guard_authority"]}
          },
          "compatibility": {
            "required": ["dataset_identity"],
            "properties": {
              "support_tiers": {
                "items": {
                  "enum": [
                    "maintained_catalog",
                    "supported_experimental",
                    "community_experimental"
                  ]
                }
              }
            }
          }
        }
      },
      "else": {
        "not": {"required": ["behavioral_claim"]}
      }
    }
  ]
}
