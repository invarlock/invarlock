{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvarLock Policy Pack",
  "type": "object",
  "required": [
    "format",
    "tier",
    "resolved_policy",
    "overrides",
    "policy_digest",
    "compatibility"
  ],
  "properties": {
    "format": {
      "const": "policy-pack-v1"
    },
    "tier": {
      "enum": ["aggressive", "balanced", "conservative"]
    },
    "resolved_policy": {
      "type": "object"
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "value"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
          },
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "compatibility": {
      "type": "object",
      "required": ["support_tiers"],
      "properties": {
        "support_tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "published_basis",
              "supported_experimental",
              "community_experimental"
            ]
          }
        },
        "adapter_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "runtime_lanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "dataset_identity": {
          "type": "object",
          "required": [
            "provider",
            "dataset_name",
            "config_name",
            "revision",
            "split"
          ],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "dataset_name": {"type": ["string", "null"]},
            "config_name": {"type": ["string", "null"]},
            "revision": {"type": ["string", "null"]},
            "split": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "change_ticket": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "effective_date": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
