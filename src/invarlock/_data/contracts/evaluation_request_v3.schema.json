{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarlock.dev/contracts/evaluation_request_v3.schema.json",
  "title": "InvarLock bounded judge evaluation request",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "const": "invarlock/evaluation-request-v3"
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "judge_import"
            },
            "collection": {
              "type": "null"
            }
          },
          "required": [
            "mode",
            "collection"
          ]
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseline_run": {
              "$ref": "#/$defs/reference"
            },
            "subject_run": {
              "$ref": "#/$defs/reference"
            },
            "plan": {
              "$ref": "#/$defs/reference"
            },
            "measurements": {
              "$ref": "#/$defs/reference"
            },
            "policy": {
              "$ref": "#/$defs/reference"
            }
          },
          "required": [
            "baseline_run",
            "subject_run",
            "plan",
            "measurements",
            "policy"
          ]
        },
        "output": {
          "$ref": "#/$defs/output"
        }
      },
      "required": [
        "format_version",
        "execution",
        "comparison",
        "output"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "const": "invarlock/evaluation-request-v3"
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "judge_collect"
            },
            "collection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "integration": {
                  "enum": [
                    "inspect-judge",
                    "runtime-provider-judge",
                    "openai-compatible-judge"
                  ]
                },
                "configuration": {
                  "$ref": "#/$defs/reference"
                },
                "workspace": {
                  "$ref": "#/$defs/reference"
                },
                "scorer_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]{1,128}(?![\\s\\S])"
                },
                "invocation_timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 604800
                },
                "model": {
                  "$ref": "#/$defs/localModel"
                }
              },
              "required": [
                "integration",
                "configuration"
              ],
              "if": {
                "properties": {
                  "integration": {
                    "const": "runtime-provider-judge"
                  }
                }
              },
              "then": {
                "required": [
                  "model"
                ],
                "not": {
                  "required": [
                    "invocation_timeout_seconds"
                  ]
                }
              },
              "else": {
                "not": {
                  "required": [
                    "model"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "integration": {
                        "const": "openai-compatible-judge"
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "invocation_timeout_seconds"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "mode",
            "collection"
          ]
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseline_run": {
              "$ref": "#/$defs/reference"
            },
            "subject_run": {
              "$ref": "#/$defs/reference"
            },
            "plan": {
              "$ref": "#/$defs/reference"
            },
            "measurements": {
              "type": "null"
            },
            "policy": {
              "$ref": "#/$defs/reference"
            }
          },
          "required": [
            "baseline_run",
            "subject_run",
            "plan",
            "measurements",
            "policy"
          ]
        },
        "output": {
          "$ref": "#/$defs/output"
        }
      },
      "required": [
        "format_version",
        "execution",
        "comparison",
        "output"
      ]
    }
  ],
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!~)(?![A-Za-z]:)(?!.*://)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!\\s)(?!.*\\s$)(?!.*\\/$)[^\\u0000-\\u001f]+(?![\\s\\S])"
    },
    "output": {
      "type": "object",
      "required": [
        "evidence",
        "signer_identity"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/reference"
        },
        "signer_identity": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])",
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "safeReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!~)(?![A-Za-z]:)(?!.*://)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!\\s)(?!.*\\s$)(?!.*\\/$)[^\\u0000-\\u001f]+(?![\\s\\S])"
    },
    "providerName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
    },
    "settingName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*://)[^\\u0000-\\u001f]+(?![\\s\\S])"
    },
    "artifactLocator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f]+(?![\\s\\S])"
    },
    "jsonScalar": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 4096
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "model_id",
        "locator"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/safeReference"
        },
        "model_id": {
          "$ref": "#/$defs/modelId"
        },
        "locator": {
          "$ref": "#/$defs/artifactLocator"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "provider",
        "settings"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerName"
        },
        "settings": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/settingName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonScalar"
          }
        }
      },
      "additionalProperties": false
    },
    "comparisonSide": {
      "type": "object",
      "required": [
        "artifact",
        "runtime"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        }
      },
      "additionalProperties": false
    },
    "localModel": {
      "allOf": [
        {
          "$ref": "#/$defs/comparisonSide"
        },
        {
          "properties": {
            "artifact": {
              "required": [
                "path"
              ]
            }
          }
        }
      ]
    }
  }
}
