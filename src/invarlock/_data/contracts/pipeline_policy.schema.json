{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarlock.dev/contracts/pipeline_policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "invarlock/pipeline-policy-v1"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "kind": {
            "enum": [
              "exact_match",
              "normalized_match",
              "numeric_tolerance",
              "json_fields",
              "json_exact",
              "token_f1",
              "recorded"
            ]
          },
          "configuration": {
            "type": "object",
            "additionalProperties": {},
            "maxProperties": 100
          },
          "direction": {
            "enum": [
              "higher",
              "lower"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "aggregation": {
            "const": "mean"
          },
          "minimum_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "maximum_regression": {
            "type": "number",
            "minimum": 0
          },
          "maximum_interval_width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "candidate_minimum": {
            "type": "number"
          },
          "candidate_maximum": {
            "type": "number"
          },
          "score_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "accepted_provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "judge",
                  "human",
                  "measurement",
                  "external_metric"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "rubric_digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind",
              "source",
              "version",
              "unit",
              "rubric_digest"
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "configuration",
          "direction",
          "unit",
          "aggregation",
          "minimum_count",
          "maximum_regression",
          "maximum_interval_width"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "normalized_match",
                    "token_f1"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "configuration": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "casefold": {
                      "type": "boolean"
                    },
                    "unicode_version": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "maxLength": 32
                    }
                  },
                  "required": [
                    "unicode_version"
                  ]
                }
              },
              "required": [
                "configuration"
              ]
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 16
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "where": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 4096
            },
            "maxProperties": 100,
            "minProperties": 1
          }
        },
        "required": [
          "name",
          "where"
        ]
      },
      "maxItems": 16
    }
  },
  "required": [
    "format",
    "metrics",
    "slices"
  ]
}
