{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarlock.dev/contracts/recipient_acceptance_policy.schema.json",
  "title": "InvarLock Recipient Acceptance Policy v2",
  "type": "object",
  "required": [
    "format",
    "expected_predicate_type",
    "trusted_signers",
    "trusted_receipt_verifiers",
    "freshness",
    "allowed_contract_versions",
    "required_technical_verdict",
    "allow_countersigned_receipts"
  ],
  "properties": {
    "format": {
      "const": "invarlock/recipient-acceptance-policy-v2"
    },
    "expected_predicate_type": {
      "type": "string",
      "format": "uri"
    },
    "trusted_signers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["identity", "fingerprint", "status"],
        "properties": {
          "identity": {
            "$ref": "#/$defs/identity"
          },
          "fingerprint": {
            "$ref": "#/$defs/digest"
          },
          "status": {
            "enum": ["active", "revoked"]
          }
        },
        "additionalProperties": false
      }
    },
    "trusted_receipt_verifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["identity", "fingerprint", "status"],
        "properties": {
          "identity": {
            "$ref": "#/$defs/identity"
          },
          "fingerprint": {
            "$ref": "#/$defs/digest"
          },
          "status": {
            "enum": ["active", "revoked"]
          }
        },
        "additionalProperties": false
      }
    },
    "expected_receipt_trust_profile_digest": {
      "$ref": "#/$defs/digest"
    },
    "freshness": {
      "type": "object",
      "required": [
        "max_envelope_age_seconds",
        "max_evidence_age_seconds",
        "clock_skew_seconds"
      ],
      "properties": {
        "max_envelope_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 315360000
        },
        "max_evidence_age_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 315360000
            },
            {
              "type": "null"
            }
          ]
        },
        "clock_skew_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "allowed_contract_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      }
    },
    "required_technical_verdict": {
      "enum": ["pass", "fail"]
    },
    "allow_countersigned_receipts": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    }
  }
}
