{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invarlock.dev/contracts/runtime_provider_receipt.schema.json",
  "title": "InvarLock Runtime Provider Receipt",
  "type": "object",
  "required": [
    "format_version",
    "plugin",
    "backend",
    "capabilities",
    "artifact_identity",
    "execution_settings",
    "device",
    "outer_image_digest",
    "scoring_observation_sha256"
  ],
  "properties": {
    "format_version": {"const": "invarlock/runtime-provider-receipt-v1"},
    "plugin": {"$ref": "#/$defs/plugin"},
    "backend": {"$ref": "#/$defs/backend"},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "artifact_identity": {
      "oneOf": [
        {"$ref": "#/$defs/hfSnapshot"},
        {"$ref": "#/$defs/gguf"},
        {"$ref": "#/$defs/tensorrtLlmEngine"}
      ]
    },
    "execution_settings": {"$ref": "#/$defs/executionSettings"},
    "device": {"$ref": "#/$defs/device"},
    "outer_image_digest": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      ]
    },
    "scoring_observation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "providerName": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "logicalName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f]+$"
    },
    "basename": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\\\u0000-\\u001f]+$",
      "not": {"enum": [".", ".."]}
    },
    "plugin": {
      "type": "object",
      "required": ["name", "provider_abi", "distribution", "distribution_version"],
      "properties": {
        "name": {"$ref": "#/$defs/providerName"},
        "provider_abi": {"const": "1"},
        "distribution": {"type": "string", "minLength": 1},
        "distribution_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "required": ["name", "version", "source_sha256", "binary_sha256", "build_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "binary_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "build_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      },
      "anyOf": [
        {"properties": {"source_sha256": {"type": "string"}}},
        {"properties": {"binary_sha256": {"type": "string"}}},
        {"properties": {"build_sha256": {"type": "string"}}}
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "format_version", "provider_name", "provider_abi", "artifact_formats",
        "tasks", "metrics", "execution_modes", "required_extra", "required_image"
      ],
      "properties": {
        "format_version": {"const": "runtime-provider-capabilities-v1"},
        "provider_name": {"$ref": "#/$defs/providerName"},
        "provider_abi": {"const": "1"},
        "artifact_formats": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["hf_snapshot", "gguf", "tensorrt_llm_engine"]}
        },
        "tasks": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
        },
        "metrics": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "enum": [
              "exact_match",
              "normalized_nll_per_utf8_byte"
            ]
          }
        },
        "execution_modes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["in_process", "local_process", "container"]}
        },
        "required_extra": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/providerName"}]},
        "required_image": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "hfSnapshot": {
      "type": "object",
      "required": ["format_version", "artifact_format", "model_id", "immutable_revision", "checkpoint_tree_sha256", "tokenizer_metadata_sha256"],
      "properties": {
        "format_version": {"const": "invarlock/model-artifact-identity-v1"},
        "artifact_format": {"const": "hf_snapshot"},
        "model_id": {"$ref": "#/$defs/logicalName"},
        "immutable_revision": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}]},
        "checkpoint_tree_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "tokenizer_metadata_sha256": {"$ref": "#/$defs/sha256"}
      },
      "anyOf": [
        {"properties": {"immutable_revision": {"type": "string"}}},
        {"properties": {"checkpoint_tree_sha256": {"type": "string"}}}
      ],
      "additionalProperties": false
    },
    "gguf": {
      "type": "object",
      "required": ["format_version", "artifact_format", "artifact_name", "sha256", "byte_length", "gguf_metadata_sha256", "tensor_inventory_sha256", "tokenizer_metadata_sha256"],
      "properties": {
        "format_version": {"const": "invarlock/model-artifact-identity-v1"},
        "artifact_format": {"const": "gguf"},
        "artifact_name": {"$ref": "#/$defs/basename"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 1},
        "gguf_metadata_sha256": {"$ref": "#/$defs/sha256"},
        "tensor_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "tokenizer_metadata_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "tensorrtLlmEngine": {
      "type": "object",
      "required": ["format_version", "artifact_format", "bundle_name", "engine_bundle_tree_sha256", "file_inventory_sha256", "builder_config_sha256", "tokenizer_metadata_sha256", "engine_metadata_sha256", "target_compute_capability"],
      "properties": {
        "format_version": {"const": "invarlock/model-artifact-identity-v1"},
        "artifact_format": {"const": "tensorrt_llm_engine"},
        "bundle_name": {"$ref": "#/$defs/basename"},
        "engine_bundle_tree_sha256": {"$ref": "#/$defs/sha256"},
        "file_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "builder_config_sha256": {"$ref": "#/$defs/sha256"},
        "tokenizer_metadata_sha256": {"$ref": "#/$defs/sha256"},
        "engine_metadata_sha256": {"$ref": "#/$defs/sha256"},
        "target_compute_capability": {"type": "string", "pattern": "^(0|[1-9][0-9]?)\\.(0|[1-9][0-9]?)$"}
      },
      "additionalProperties": false
    },
    "executionSettings": {
      "type": "object",
      "required": ["seed", "context_length", "batch_size", "max_output_tokens", "timeout_seconds", "allow_network"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "context_length": {"type": "integer", "minimum": 1},
        "batch_size": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "allow_network": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "required": ["device_kind", "device_name", "compute_capability", "driver_version", "cuda_runtime_version"],
      "properties": {
        "device_kind": {"$ref": "#/$defs/providerName"},
        "device_name": {"type": "string", "minLength": 1},
        "compute_capability": {"type": ["string", "null"], "pattern": "^[0-9]{1,2}\\.[0-9]{1,2}$"},
        "driver_version": {"type": ["string", "null"], "minLength": 1},
        "cuda_runtime_version": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
